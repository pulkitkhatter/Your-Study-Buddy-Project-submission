<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".AdminScreenActivity">

    <!-- Title Section -->
    <TextView
        android:id="@+id/tvAdminTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Admin Dashboard"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Mentor Count -->
    <TextView
        android:id="@+id/tvMentorCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Total Mentors: 0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvAdminTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Student Count -->
    <TextView
        android:id="@+id/tvStudentCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Total Students: 0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvMentorCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Buttons to View Mentors and Students -->
    <Button
        android:id="@+id/btnViewMentors"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="View Mentors"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/material_dynamic_neutral0"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/tvStudentCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnViewStudents"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="View Students"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/material_dynamic_primary0"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/btnViewMentors"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Mentor RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMentorList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnViewStudents"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:paddingBottom="16dp"/>

    <!-- Student RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStudentList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/btnViewStudents"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:paddingBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
